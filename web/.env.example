# Pure Scaffold Essentials
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SPECFORGE_API_URL=/v1
LUAS_API_PROXY_TARGET=http://localhost:2010
# Set true to authenticate /api/auth/login against the CodingCTO API and inject its JWT into /v1 proxy calls.
LUAS_AUTH_BACKEND_ENABLED=false
NEXT_PUBLIC_DEPLOY_API_URL=http://localhost:2010/v1
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:2010/v1
NEXT_PUBLIC_APP_URL=http://localhost:2020
NEXT_PUBLIC_GITHUB_APP_SLUG=
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=

# Optional
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
